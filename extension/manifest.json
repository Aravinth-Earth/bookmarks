{
  "manifest_version": 3,
  "name": "Bookmarks — collected links",
  "version": "0.1.0",
  "description": "Optional companion for a bookmark vault on b.332321.xyz. Keeps a local list of the addresses you open, so you can add the ones worth keeping.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "spanning",
  "action": {
    "default_title": "Bookmarks — collected links"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
