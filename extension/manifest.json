{
  "manifest_version": 3,
  "name": "Bookmarks \u2014 collected links",
  "version": "0.2.4",
  "description": "Optional companion for a bookmark vault on b.332321.xyz. Keeps a local list of the addresses you open, so you can add the ones worth keeping.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "spanning",
  "action": {
    "default_title": "Bookmarks \u2014 collected links"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://b.332321.xyz/w/bookmarks/*",
        "http://127.0.0.1/w/bookmarks/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
